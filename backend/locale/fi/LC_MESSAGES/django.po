#: slider/templates/slider/index.html:33
msgid "Image upload disabled"
msgstr "Kuvien lataus pois käytöstä"

#: slider/templates/slider/index.html:37
msgid ""
"\n"
"            Your name in the field below is required to enable uploading.\n"
"            It will be visible in the picture slideshow.\n"
"            "
msgstr ""
"\n"
"Nimesi tarvitaan jotta kuvien lataaminen on mahdollista. Se näkyy kuvan "
"alalaidassa."

#: slider/templates/slider/index.html:45 slider/templates/slider/index.html:46
msgid "Author of images"
msgstr "Kuvan lataaja"

#: slider/templates/slider/index.html:48
msgid "Or enter a single dot if you don't care."
msgstr "Tai anna nimeksi pelkkä piste jos et halua nimeä näkyviin."

#: slider/templates/slider/index.html:58
msgid "Drop pictures here."
msgstr "Pudota kuvasti tähän."

#: slider/templates/slider/index.html:59
msgid "Or click to choose from device."
msgstr "Tai klikkaa ja valitse kuva(t) itse."

#: slider/templates/slider/index.html:62
msgid "Upload will start automatically."
msgstr "Lataus alkaa automaattisesti."

#: slider/templates/slider/index.html:76
msgid "Upload complete"
msgstr "Lataus valmis"
